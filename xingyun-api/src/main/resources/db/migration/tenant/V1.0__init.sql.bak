-- ----------------------------
-- Table structure for sys_menu_collect
-- ----------------------------
DROP TABLE IF EXISTS `sys_menu_collect`;
CREATE TABLE `sys_menu_collect` (
  `id` varchar(32) NOT NULL COMMENT 'ID',
  `user_id` varchar(32) NOT NULL COMMENT '鐢ㄦ埛ID',
  `menu_id` varchar(32) NOT NULL COMMENT '鑿滃崟ID',
  PRIMARY KEY (`id`),
  UNIQUE KEY `user_id, menu_id` (`user_id`,`menu_id`) USING BTREE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='鑿滃崟鏀惰棌';

-- ----------------------------
-- Table structure for sys_notice
-- ----------------------------
DROP TABLE IF EXISTS `sys_notice`;
CREATE TABLE `sys_notice` (
  `id` varchar(32) CHARACTER SET utf8mb4 NOT NULL COMMENT 'ID',
  `title` varchar(200) CHARACTER SET utf8mb4 NOT NULL COMMENT '鏍囬',
  `content` longtext COLLATE utf8mb4_unicode_ci NOT NULL COMMENT '鍐呭',
  `available` tinyint(1) NOT NULL DEFAULT '1' COMMENT '鐘舵€?,
  `published` tinyint(1) NOT NULL DEFAULT '0' COMMENT '鏄惁鍙戝竷',
  `create_by` varchar(32) CHARACTER SET utf8mb4 NOT NULL COMMENT '鍒涘缓浜?,
  `create_by_id` varchar(32) CHARACTER SET utf8mb4 NOT NULL COMMENT '鍒涘缓浜篒D',
  `create_time` datetime NOT NULL COMMENT '鍒涘缓鏃堕棿',
  `update_by` varchar(32) CHARACTER SET utf8mb4 NOT NULL COMMENT '淇敼浜?,
  `update_by_id` varchar(32) CHARACTER SET utf8mb4 NOT NULL COMMENT '淇敼浜篒D',
  `update_time` datetime NOT NULL COMMENT '淇敼鏃堕棿',
  `readed_num` int(11) NOT NULL DEFAULT '0' COMMENT '宸茶浜烘暟',
  `un_read_num` int(11) NOT NULL DEFAULT '0' COMMENT '鏈浜烘暟',
  `publish_time` datetime DEFAULT NULL COMMENT '鍙戝竷鏃堕棿',
  PRIMARY KEY (`id`) USING BTREE
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COLLATE=utf8mb4_unicode_ci COMMENT='绯荤粺閫氱煡';

-- ----------------------------
-- Records of sys_notice
-- ----------------------------
BEGIN;
COMMIT;

-- ----------------------------
-- Table structure for sys_notice_log
-- ----------------------------
DROP TABLE IF EXISTS `sys_notice_log`;
CREATE TABLE `sys_notice_log` (
  `id` varchar(32) NOT NULL COMMENT 'ID',
  `notice_id` varchar(32) NOT NULL COMMENT '鏍囬',
  `user_id` varchar(32) NOT NULL COMMENT '鐢ㄦ埛ID',
  `readed` tinyint(1) NOT NULL DEFAULT '0' COMMENT '鏄惁宸茶',
  `read_time` datetime DEFAULT NULL COMMENT '宸茶鏃堕棿',
  PRIMARY KEY (`id`) USING BTREE,
  UNIQUE KEY `notice_id` (`notice_id`,`user_id`),
  KEY `user_id` (`user_id`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='绯荤粺閫氱煡璁板綍';

-- ----------------------------
-- Records of sys_notice_log
-- ----------------------------
BEGIN;
COMMIT;

-- ----------------------------
-- Table structure for sys_parameter
-- ----------------------------
DROP TABLE IF EXISTS `sys_parameter`;
CREATE TABLE `sys_parameter` (
  `id` bigint(20) NOT NULL AUTO_INCREMENT COMMENT 'ID',
  `pm_key` varchar(100) NOT NULL COMMENT '閿?,
  `pm_value` varchar(200) DEFAULT NULL COMMENT '鍊?,
  `description` varchar(200) NOT NULL DEFAULT '' COMMENT '澶囨敞',
  `create_by` varchar(32) NOT NULL COMMENT '鍒涘缓浜?,
  `create_by_id` varchar(32) NOT NULL COMMENT '鍒涘缓浜篒D',
  `create_time` datetime NOT NULL COMMENT '鍒涘缓鏃堕棿',
  `update_by` varchar(32) NOT NULL COMMENT '淇敼浜?,
  `update_by_id` varchar(32) NOT NULL COMMENT '淇敼浜篒D',
  `update_time` datetime NOT NULL COMMENT '淇敼鏃堕棿',
  PRIMARY KEY (`id`),
  UNIQUE KEY `pm_key` (`pm_key`)
) ENGINE=InnoDB AUTO_INCREMENT=9 DEFAULT CHARSET=utf8mb4 COMMENT='绯荤粺鍙傛暟';

