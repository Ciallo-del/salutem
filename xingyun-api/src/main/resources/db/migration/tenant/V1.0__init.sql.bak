-- ----------------------------
-- Table structure for sys_menu
-- ----------------------------
DROP TABLE IF EXISTS `sys_menu`;
CREATE TABLE `sys_menu` (
  `id` varchar(32) NOT NULL COMMENT 'ID',
  `code` varchar(20) NOT NULL COMMENT '缂栧彿',
  `name` varchar(200) DEFAULT NULL COMMENT '鍚嶇О锛堝墠绔娇鐢級',
  `title` varchar(20) NOT NULL COMMENT '鏍囬',
  `icon` varchar(200) DEFAULT NULL COMMENT '鍥炬爣',
  `component_type` tinyint(3) DEFAULT NULL COMMENT '缁勪欢绫诲瀷锛堝墠绔娇鐢級',
  `component` varchar(200) DEFAULT NULL COMMENT '缁勪欢锛堝墠绔娇鐢級',
  `request_param` longtext COMMENT '鑷畾涔夎姹傚弬鏁?,
  `parent_id` varchar(32) DEFAULT NULL COMMENT '鐖剁骇ID',
  `path` varchar(200) DEFAULT NULL COMMENT '璺敱璺緞锛堝墠绔娇鐢級',
  `no_cache` tinyint(1) NOT NULL DEFAULT '1' COMMENT '鏄惁缂撳瓨锛堝墠绔娇鐢級',
  `display` tinyint(3) NOT NULL COMMENT '绫诲瀷 0-鐩綍 1-鑿滃崟 2-鍔熻兘',
  `hidden` tinyint(1) DEFAULT '0' COMMENT '鏄惁闅愯棌锛堝墠绔娇鐢級',
  `permission` varchar(200) DEFAULT NULL COMMENT '鏉冮檺',
  `is_special` tinyint(1) NOT NULL DEFAULT '0' COMMENT '鏄惁鐗规畩鑿滃崟',
  `available` tinyint(1) NOT NULL DEFAULT '1' COMMENT '鐘舵€?,
  `description` varchar(200) NOT NULL DEFAULT '' COMMENT '澶囨敞',
  `create_by` varchar(32) NOT NULL COMMENT '鍒涘缓浜篒D',
  `create_by_id` varchar(32) NOT NULL COMMENT '鍒涘缓浜篒D',
  `create_time` datetime NOT NULL COMMENT '鍒涘缓鏃堕棿',
  `update_by` varchar(32) NOT NULL COMMENT '淇敼浜篒D',
  `update_by_id` varchar(32) NOT NULL COMMENT '淇敼浜篒D',
  `update_time` datetime NOT NULL COMMENT '淇敼鏃堕棿',
  PRIMARY KEY (`id`),
  KEY `code` (`code`,`name`,`title`)
) ENGINE=InnoDB DEFAULT CHARSET=utf8mb4 COMMENT='鑿滃崟';

