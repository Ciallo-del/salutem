  UNIQUE INDEX `dic_id`(`dic_id`, `code`) USING BTREE,
  UNIQUE INDEX `dic_id_2`(`dic_id`, `name`) USING BTREE
) ENGINE = InnoDB CHARACTER SET = utf8mb4 COLLATE = utf8mb4_general_ci COMMENT = '鏁版嵁瀛楀吀' ROW_FORMAT = DYNAMIC;

